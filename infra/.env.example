POSTGRES_USER=sales_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sales

# Airflow. FERNET_KEY и WEBSERVER__SECRET_KEY — сгенерировать один раз при бутстрапе,
# менять их после старта нельзя: FERNET_KEY шифрует сохранённые в БД Airflow пароли/connections.
AIRFLOW_FERNET_KEY=changeme
AIRFLOW_WEBSERVER_SECRET_KEY=changeme
AIRFLOW_ADMIN_PASSWORD=changeme
